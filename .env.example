# Copy this file to ".env" to change settings. Everything is optional.
PORT=3000

# Show sample events and sample "demo" profiles (true/false)
SHOW_DEMO_DATA=true

# Set to 0.0.0.0 to let phones on your Wi-Fi open the site
HOST=127.0.0.1

# Set to true only when you serve the site over HTTPS
COOKIE_SECURE=false
